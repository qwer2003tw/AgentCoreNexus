#!/usr/bin/env bash
# PreToolUse Hook - 操作前驗證和安全檢查
#
# 這是 Cline Hook（非 Git Hook）
# 在 Cline 使用任何工具前觸發，用於驗證操作和注入上下文

input=$(cat)

tool_name=$(echo "$input" | jq -r '.preToolUse.toolName')
file_path=$(echo "$input" | jq -r '.preToolUse.parameters.path // empty')

# ============================================
# 規則 1: 阻止在 Python 專案創建 TypeScript 文件
# ============================================
if [[ "$tool_name" == "write_to_file" ]]; then
  # 檢查是否為 Python 專案
  if [[ -f "requirements.txt" ]] || [[ -f "pyproject.toml" ]]; then
    # 阻止創建 .ts/.tsx 文件
    if [[ "$file_path" == *.ts ]] || [[ "$file_path" == *.tsx ]]; then
      echo '{"cancel": true, "errorMessage": "❌ 這是 Python 專案，不應創建 TypeScript 文件。請使用 .py 擴展名。"}'
      exit 0
    fi
  fi
fi

# ============================================
# 規則 2: 檢測測試文件中的 print() 語句
# ============================================
if [[ "$tool_name" == "write_to_file" ]] && [[ "$file_path" == *"test_"* ]]; then
  content=$(echo "$input" | jq -r '.preToolUse.parameters.content // empty')
  if [[ -n "$content" ]] && echo "$content" | grep -q "print("; then
    context="CODING_STANDARD: 檢測到測試文件中使用 print()。測試文件中應使用 logger 而非 print()，以便正確記錄和測試輸出。建議使用 'from utils.logger import get_logger' 然後 'logger.info()'。"
    jq -n --arg ctx "$context" '{"cancel": false, "contextModification": $ctx}'
    exit 0
  fi
fi

# ============================================
# 規則 3: 確保測試命令使用 Python 3.12
# ============================================
if [[ "$tool_name" == "execute_command" ]]; then
  command=$(echo "$input" | jq -r '.preToolUse.parameters.command // empty')
  
  # 檢查是否為 pytest 命令
  if echo "$command" | grep -q "pytest" && ! echo "$command" | grep -q "python3.12"; then
    context="TESTING_STANDARD: 測試必須使用 python3.12 執行。檢測到直接使用 pytest 命令。正確格式應為：'python3.12 -m pytest ...'。這確保使用正確的 Python 版本和測試依賴。"
    jq -n --arg ctx "$context" '{"cancel": false, "contextModification": $ctx}'
    exit 0
  fi
fi

# ============================================
# 規則 4: 警告直接修改 deployment/ 目錄
# ============================================
if [[ "$tool_name" == "write_to_file" ]] || [[ "$tool_name" == "replace_in_file" ]]; then
  if [[ "$file_path" == *"deployment/"* ]]; then
    context="DOCUMENTATION: 您正在修改 deployment/ 目錄中的專案專屬知識文檔。這些是重要的實戰經驗記錄，修改時請確保保留關鍵信息並更新版本號。"
    jq -n --arg ctx "$context" '{"cancel": false, "contextModification": $ctx}'
    exit 0
  fi
fi

# ============================================
# 規則 5: 提醒在 telegram-lambda 使用 Python 而非 Node.js
# ============================================
if [[ "$tool_name" == "write_to_file" ]]; then
  if [[ "$file_path" == "telegram-lambda/"* ]] && [[ "$file_path" == *.js ]]; then
    echo '{"cancel": true, "errorMessage": "❌ telegram-lambda 是 Python 專案，不應包含 .js 文件。如果需要 Node.js 功能，請考慮創建單獨的組件。"}'
    exit 0
  fi
fi

# ============================================
# 規則 6: 強制 SAM 部署，禁止直接更新 Lambda ⭐⭐⭐
# ============================================
if [[ "$tool_name" == "execute_command" ]]; then
  command=$(echo "$input" | jq -r '.preToolUse.parameters.command // empty')
  
  # 檢測禁止的 Lambda 更新命令
  if echo "$command" | grep -E "aws lambda update-function-(code|configuration)" > /dev/null; then
    error_msg="🚫 INFRASTRUCTURE AS CODE 違規

❌ 檢測到禁止的命令：
   $(echo "$command" | grep -o 'aws lambda update[^;]*')

⛔ 此命令違反 Infrastructure as Code 原則！

✅ 正確做法：使用 SAM 進行所有部署

   方法 1（推薦）：使用 Workflow
   /deploy-lambda.md
   
   方法 2：手動 SAM 部署
   cd [component-directory]
   sam build
   sam deploy --stack-name STACK_NAME --region us-west-2

📚 為什麼禁止：
   • SAM 管理完整的基礎設施狀態
   • 確保配置一致性和可追蹤
   • 支援版本控制和回滾
   • 下次 SAM deploy 會覆蓋手動變更

📖 參考：.clinerules/rules/deployment-iac.md"
    
    jq -n --arg msg "$error_msg" '{"cancel": true, "errorMessage": $msg}'
    exit 0
  fi
  
  # 檢測其他繞過 IaC 的命令
  if echo "$command" | grep -E "aws lambda (publish-version|create-alias|update-alias)" > /dev/null; then
    error_msg="🚫 請使用 SAM 管理 Lambda 版本和別名

template.yaml 中配置 AutoPublishAlias 或 Versions，不要使用 AWS CLI 直接操作。"
    jq -n --arg msg "$error_msg" '{"cancel": true, "errorMessage": $msg}'
    exit 0
  fi
  
  # ============================================
  # 規則 7: 前端 Build 前提醒驗證配置 ⭐⭐⭐
  # ============================================
  if echo "$command" | grep -E "npm run build|vite build|npx vite build" > /dev/null; then
    # 檢查是否在前端目錄
    if echo "$PWD" | grep -q "frontend"; then
      context="FRONTEND_DEPLOYMENT: 前端 Build 檢查清單

⚠️ 重要提醒：
1. 檢查 .env 文件配置（從 CloudFormation 獲取最新 endpoints）
2. 清除 build 緩存：rm -rf dist/ node_modules/.vite
3. Build 後必須驗證 bundle：
   grep -o 'https://.*execute-api.*' dist/assets/*.js
4. 確認包含正確的 endpoint 再部署

📖 參考：.clinerules/rules/frontend-deployment.md"
      jq -n --arg ctx "$context" '{"cancel": false, "contextModification": $ctx}'
      exit 0
    fi
  fi
  
  # 檢測未驗證的前端上傳
  if echo "$command" | grep -E "s3 sync.*frontend.*dist" > /dev/null; then
    error_msg="🚫 前端部署驗證失敗

❌ 禁止未驗證就上傳前端！

✅ 正確流程：
1. Build：npm run build
2. 驗證 bundle：
   grep 'jooap0xv8l' dist/assets/index-*.js
3. 確認正確後才能上傳

如果已驗證，請在命令前加上驗證結果。

📖 參考：.clinerules/rules/frontend-deployment.md"
    
    jq -n --arg msg "$error_msg" '{"cancel": true, "errorMessage": $msg}'
    exit 0
  fi
fi

# 所有檢查通過
echo '{"cancel": false}'
