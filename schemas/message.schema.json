{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Universal Message Schema",
  "description": "Standard message format for all AgentCoreNexus channel adapters",
  "version": "1.0.0",
  "type": "object",
  "required": ["messageId", "timestamp", "channel", "user", "content"],
  "properties": {
    "messageId": {
      "type": "string",
      "description": "Unique identifier for the message"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when the message was created"
    },
    "channel": {
      "type": "object",
      "description": "Information about the message source channel",
      "required": ["type", "channelId"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["telegram", "web", "discord", "slack"],
          "description": "Type of the channel adapter"
        },
        "channelId": {
          "type": "string",
          "description": "Unique identifier for the channel instance"
        },
        "metadata": {
          "type": "object",
          "description": "Channel-specific metadata",
          "additionalProperties": true
        }
      }
    },
    "user": {
      "type": "object",
      "description": "Information about the message sender",
      "required": ["id", "channelUserId"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unified user ID across all channels"
        },
        "channelUserId": {
          "type": "string",
          "description": "User ID specific to the channel"
        },
        "username": {
          "type": "string",
          "description": "User's display name or username"
        },
        "displayName": {
          "type": "string",
          "description": "User's friendly display name"
        }
      }
    },
    "content": {
      "type": "object",
      "description": "Message content",
      "required": ["messageType"],
      "properties": {
        "text": {
          "type": "string",
          "description": "Text content of the message"
        },
        "messageType": {
          "type": "string",
          "enum": ["text", "image", "file", "video", "audio"],
          "description": "Type of the message content"
        },
        "attachments": {
          "type": "array",
          "description": "List of attachments included with the message",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "description": "Type of attachment"
              },
              "url": {
                "type": "string",
                "format": "uri",
                "description": "URL to the attachment"
              },
              "s3_url": {
                "type": "string",
                "description": "S3 URL for stored attachments"
              },
              "filename": {
                "type": "string",
                "description": "Original filename"
              },
              "mimeType": {
                "type": "string",
                "description": "MIME type of the attachment"
              },
              "size": {
                "type": "integer",
                "description": "Size in bytes"
              }
            }
          }
        }
      }
    },
    "conversationId": {
      "type": "string",
      "description": "ID of the conversation thread (optional)"
    },
    "replyTo": {
      "type": "string",
      "description": "ID of the message being replied to (optional)"
    }
  }
}