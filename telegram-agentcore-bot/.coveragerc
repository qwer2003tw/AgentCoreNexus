[run]
source = .
omit = 
    */tests/*
    */test_*.py
    */__pycache__/*
    */venv/*
    */.venv/*
    */site-packages/*
    */.aws-sam/*
    */build/*
    */dist/*
    setup.py
    run_tests.py
    run_tests_with_coverage.sh
    test_imports.sh

[report]
# 覆蓋率報告配置
precision = 2
show_missing = True
skip_covered = False

# 排除行
exclude_lines =
    # 標準排除
    pragma: no cover
    def __repr__
    def __str__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod
    @abc.abstractmethod
    # 調試代碼
    if DEBUG:
    if VERBOSE:
    # 平台特定代碼
    if sys.platform
    
[html]
directory = htmlcov
title = telegram-agentcore-bot Coverage Report

[xml]
output = coverage.xml