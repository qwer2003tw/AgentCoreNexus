#!/bin/bash
# 配置 GitHub Secrets 腳本範本
# 用於設置 E2E 測試所需的環境變數
#
# 使用方式：
# 1. 複製此文件：cp configure_github_secrets.sh.example configure_github_secrets.sh
# 2. 編輯 configure_github_secrets.sh，填入實際密碼
# 3. 執行：./configure_github_secrets.sh

set -e

echo "🔐 配置 GitHub Secrets for E2E Testing"
echo "========================================"
echo ""

# 檢查 gh CLI
if ! command -v gh &> /dev/null; then
    echo "❌ GitHub CLI (gh) 未安裝"
    echo "請先安裝: https://cli.github.com/"
    exit 1
fi

# 檢查認證
if ! gh auth status &> /dev/null; then
    echo "⚠️  GitHub CLI 未認證"
    echo "執行: gh auth login"
    exit 1
fi

echo "✅ GitHub CLI 已就緒"
echo ""

# API Endpoints
echo "📡 配置 API Endpoints..."
gh secret set TEST_API_ENDPOINT --body "https://kvofk12uz2.execute-api.us-west-2.amazonaws.com/prod"
echo "  ✅ TEST_API_ENDPOINT"

gh secret set TEST_WS_ENDPOINT --body "wss://cfsm0w7id2.execute-api.us-west-2.amazonaws.com/prod"
echo "  ✅ TEST_WS_ENDPOINT"

# 測試帳號
echo ""
echo "👥 配置測試帳號..."

# ⚠️ 請替換以下 YOUR_PASSWORD_HERE 為實際密碼
TEST_PASSWORD="YOUR_PASSWORD_HERE"

gh secret set TEST_USER_1_EMAIL --body "aws-e2e-test1@test.com"
gh secret set TEST_USER_1_PASSWORD --body "$TEST_PASSWORD"
echo "  ✅ TEST_USER_1 (aws-e2e-test1@test.com)"

gh secret set TEST_USER_2_EMAIL --body "aws-e2e-test2@test.com"
gh secret set TEST_USER_2_PASSWORD --body "$TEST_PASSWORD"
echo "  ✅ TEST_USER_2 (aws-e2e-test2@test.com)"

gh secret set TEST_USER_3_EMAIL --body "aws-e2e-test3@test.com"
gh secret set TEST_USER_3_PASSWORD --body "$TEST_PASSWORD"
echo "  ✅ TEST_USER_3 (aws-e2e-test3@test.com)"

gh secret set TEST_USER_4_EMAIL --body "aws-e2e-test4@test.com"
gh secret set TEST_USER_4_PASSWORD --body "$TEST_PASSWORD"
echo "  ✅ TEST_USER_4 (aws-e2e-test4@test.com)"

echo ""
echo "✅ 所有 Secrets 配置完成！"
echo ""
echo "📊 配置摘要:"
echo "  - API Endpoints: 2 個"
echo "  - 測試帳號: 4 組 (email + password)"
echo "  - 總計: 10 個 secrets"
echo ""
echo "🔍 驗證配置:"
echo "  gh secret list"
echo ""
echo "🚀 下一步:"
echo "  1. git add ."
echo "  2. git commit -m 'feat: configure E2E test accounts'"
echo "  3. git push"
echo "  4. 檢查 GitHub Actions 執行結果"